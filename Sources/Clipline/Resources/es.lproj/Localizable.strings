/* Spanish. */

/* AppDelegate */
"Let Clipline handle your screenshots?" = "¿Quieres que Clipline se encargue de tus capturas?";
"Screenshots will hang on the line the instant you take them, without the floating thumbnail, and will not pile up on your Desktop. Drag one to a folder to keep it, or discard it with the cross. You can turn this off from the menu bar, and your settings come back when Clipline quits." = "Las capturas se colgarán al instante, sin la miniatura flotante, y no se acumularán en el Escritorio. Arrastra una a una carpeta para guardarla, o descártala con la cruz. Puedes desactivarlo desde la barra de menús, y tus ajustes vuelven a ser los de antes al salir de Clipline.";
"Turn on" = "Activar";
"Not now" = "Ahora no";
"Hide line" = "Ocultar tendedero";
"Show line" = "Mostrar tendedero";
"Handle screenshots" = "Encargarse de las capturas";
"Screenshots hang instantly and skip the Desktop" = "Las capturas se cuelgan al instante y no pasan por el Escritorio";
"Open screenshots folder" = "Abrir carpeta de capturas";
"Sounds" = "Sonidos";
"Open at login" = "Abrir al iniciar sesión";
"Quit Clipline" = "Salir de Clipline";
"Could not change the login setting" = "No se pudo cambiar el inicio de sesión";
"Move Clipline to the Applications folder and try again." = "Mueve Clipline a la carpeta Aplicaciones y vuelve a intentarlo.";

